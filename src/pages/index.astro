---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
const computationalBiologyCategories=['Computational Biology','Bioinformatics','Virtual Cell','Precision Medicine'];
const featuredPosts=posts.filter(post=>computationalBiologyCategories.includes(post.data.category)).slice(0,5);
const base=import.meta.env.BASE_URL;
---
<Base><section class="hero shell"><div class="kicker eyebrow">Personal blog · Birmingham / Global</div><h1 class="serif"><span>Biology is</span><span>becoming</span><em>programmable.</em></h1><div class="dek"><p>Long-form thinking at the intersection of computational biology, virtual cells, digital twins and precision medicine.</p><a class="button" href={`${base}blog/`}>Explore all writing <span>↗</span></a></div><div class="orb"><img src={`${base}images/phpham.jpg`} alt="Phuc Pham" /></div></section><section class="shell section"><div class="section-head"><span class="eyebrow">Computational Biology · Latest field notes</span><a class="mono section-link" href={`${base}topics/computational-biology/`}>Explore research ↗</a></div><div class="grid">{featuredPosts.map((post,i)=><PostCard post={post} large={i===0}/>)}</div></section><section class="shell manifesto"><span class="eyebrow">My Philosophy</span><p class="serif"> To model life is to search for its hidden order; to understand life is to look beyond the model. </p></section><section class="shell topics"><a href={`${base}topics/computational-biology/`} class="topic primary-topic"><span>Research focus</span><h3>Computational Biology</h3><p>Models, virtual cells, and precision medicine.</p></a><a href={`${base}topics/other/`} class="topic other-topic"><span>Beyond the lab</span><h3>Other</h3><p>Writing on Science, Culture, and Intellectual History — other interests beyond Computational Biology.</p></a></section></Base>
<style>.hero{min-height:690px;position:relative;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);column-gap:2rem;align-content:start;padding:4.5rem 0;border-bottom:1px solid var(--ink);overflow:hidden}.kicker{grid-column:1/-1}.hero h1{grid-column:1;font-size:clamp(3rem,7vw,7.5rem);line-height:.9;letter-spacing:-.065em;margin:2.5rem 0;position:relative;z-index:2}.hero h1 span,.hero h1 em{display:block}.hero h1 em{font-weight:400;color:var(--blue)}.dek{grid-column:1;max-width:560px;margin:0;position:relative;z-index:2}.dek p{font-size:1.1rem}.orb{position:relative;grid-column:2;grid-row:2/4;align-self:center;justify-self:end;width:min(100%,410px);aspect-ratio:1;border-radius:50%;border:1px solid var(--ink);background:#10110e;overflow:hidden}.orb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:contrast(1.08)}.section{padding:5rem 0}.section-head{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:.5rem 1rem;border-bottom:1px solid var(--ink);padding-bottom:.7rem;margin-bottom:1.2rem}.section-head .mono{font-size:.7rem}.section-link{font-size:.7rem;text-transform:uppercase;letter-spacing:.05em}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.manifesto{border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);padding:5rem 0}.manifesto p{font-size:clamp(2.4rem,5vw,5.2rem);line-height:1.02;letter-spacing:-.035em;max-width:1100px;margin:2rem 0}.topics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));padding-top:5rem}.topic{padding:2rem;border-left:1px solid var(--ink);min-height:260px}.topic:last-child{border-right:1px solid var(--ink)}.topic span{font:12px "DM Mono"}.topic h3{font:2rem Newsreader;margin-top:5rem}.topic p{color:var(--muted)}@media(max-width:750px){.hero{display:block;min-height:0;padding:2rem 0 3rem}.hero h1{font-size:clamp(2.8rem,12vw,4.6rem);margin:clamp(10rem,34vw,13rem) 0 1.5rem}.orb{position:absolute;width:min(66vw,240px);height:auto;right:0;top:1rem}.grid,.topics{grid-template-columns:1fr}.topic{border-right:1px solid var(--ink);border-bottom:1px solid var(--ink);padding:1.5rem}.topic h3{margin-top:3rem}.section,.manifesto{padding:3rem 0}}</style>
