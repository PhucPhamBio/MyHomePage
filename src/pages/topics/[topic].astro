---
import { getCollection } from 'astro:content';import Base from '../../layouts/Base.astro';import PostCard from '../../components/PostCard.astro';
const map={
 'computational-biology':['Computational Biology','Bioinformatics','Virtual Cell','Precision Medicine'],
 'america':['America','China'],
 'karate':['Karate'],
 'other':['America','China','Karate']
};
export function getStaticPaths(){return ['computational-biology','america','karate','other'].map(topic=>({params:{topic}}))}
const titles={ 'computational-biology':'Computational Biology',america:'America & China',karate:'Karate',other:'Other Topics' } as const;
const topic=Astro.params.topic as keyof typeof map;const categories=map[topic];const all=await getCollection('blog');const posts=all.filter(p=>categories.includes(p.data.category));const title=titles[topic];
---
<Base title={`${title} · Phuc / Field Notes`}><section class="shell intro"><span class="eyebrow">Topic dossier</span><h1 class="serif">{title}</h1><p>{topic==='computational-biology'?'Models, data, virtual cells, and the path toward individualized medicine.':topic==='other'?'Writing on Science, Culture, and Intellectual History — other interests beyond Computational Biology.':topic==='america'?'Field notes about science, institutions, and everyday life across America and China.':'Essays on technique, discipline, history, and the long practice of karate.'}</p></section><section class="shell grid">{posts.map(post=><PostCard post={post}/>)}</section></Base><style>.intro{padding:6rem 0;border-bottom:1px solid var(--ink);margin-bottom:1rem}.intro h1{font-size:clamp(4rem,10vw,9rem);line-height:.85;margin:2rem 0}.intro p{font-size:1.2rem;max-width:650px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}@media(max-width:700px){.grid{grid-template-columns:1fr}}</style>
