---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Research | Phuc Pham" active="Research">
  <section class="page-intro">
    <div class="eyebrow">Research</div>
    <h1>Research interests</h1>
    <p class="hero-copy">Exploring computational methods that help us understand biological systems and discover new scientific insights.</p>
  </section>
  <section class="section two-col">
    <div class="info-panel">
      <h3>AI for Biology</h3>
      <p>Machine learning, foundation models, and agentic systems for biological discovery.</p>
    </div>
    <div class="info-panel">
      <h3>Virtual Cell</h3>
      <p>Data-driven representations of cellular states, perturbations, and responses.</p>
    </div>
    <div class="info-panel">
      <h3>Multi-omics</h3>
      <p>Integrating molecular measurements to study biological systems across scales.</p>
    </div>
    <div class="info-panel">
      <h3>Drug Discovery</h3>
      <p>Computational modeling of molecular interactions and therapeutic hypotheses.</p>
    </div>
  </section>
</BaseLayout>