---
import { getCollection } from 'astro:content';import Base from '../../layouts/Base.astro';import PostCard from '../../components/PostCard.astro';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
const computationalBiologyCategories=['Computational Biology','Bioinformatics','Virtual Cell','Precision Medicine'];
const computationalBiologyPosts=posts.filter(post=>computationalBiologyCategories.includes(post.data.category));
const otherPosts=posts.filter(post=>!computationalBiologyCategories.includes(post.data.category));
---
<Base title="Essays · Phuc / Field Notes"><section class="shell intro"><span class="eyebrow">Research notes / Essays</span><h1 class="serif">Understanding<br><em>living systems.</em></h1><p>Writing on computational biology, virtual cells, digital twins and precision medicine, alongside a few other interests.</p></section><section class="shell archive-section"><div class="section-head"><h2 class="eyebrow">Computational Biology</h2><span class="mono">{computationalBiologyPosts.length} essays</span></div><div class="grid">{computationalBiologyPosts.map(post=><PostCard post={post}/>)}</div></section><section class="shell archive-section other-section"><div class="section-head"><h2 class="eyebrow">Other</h2><span class="mono">America · China · Karate</span></div><div class="grid">{otherPosts.map(post=><PostCard post={post}/>)}</div></section></Base><style>.intro{padding:5rem 0 3rem;border-bottom:1px solid var(--ink);margin-bottom:1rem}.intro h1{font-size:clamp(4rem,9vw,8rem);line-height:.85;letter-spacing:-.05em;margin:1.5rem 0}.intro em{color:var(--red);font-weight:400}.intro p{max-width:600px;color:var(--muted)}.archive-section{padding-top:2rem}.other-section{padding-top:5rem}.section-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;border-bottom:1px solid var(--ink);padding-bottom:.7rem;margin-bottom:1.2rem}.section-head h2{margin:0}.section-head .mono{font-size:.7rem}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}@media(max-width:700px){.grid{grid-template-columns:1fr}}</style>
