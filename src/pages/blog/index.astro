---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Blog | Phuc Pham" description="Research notes and essays." active="Blog">
  <section class="page-intro">
    <div class="eyebrow">Writing & notes</div>
    <h1>Blog</h1>
    <p class="hero-copy">Ideas, technical notes, research perspectives, and things I am learning.</p>
  </section>
  <section class="section">
    <div class="post-list">
      {posts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          date={post.data.pubDate}
          href={`/blog/${post.id}/`}
          tags={post.data.tags}
        />
      ))}
    </div>
  </section>
</BaseLayout>