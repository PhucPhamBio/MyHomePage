---
const { href, mode='read' } = Astro.props;
---
<span class="view-count" data-view-count data-view-mode={mode} data-view-href={href} aria-label="Loading views" title="Loading views">
  <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
  <span data-view-value>…</span>
</span>

<script>
  import '../scripts/view-count';
</script>

<style>
  .view-count{display:inline-flex;align-items:center;gap:.3rem;color:var(--muted);font:500 .72rem "DM Mono",monospace;white-space:nowrap}
  .view-count svg{flex:0 0 auto}
</style>
