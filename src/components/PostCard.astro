---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ViewCount from './ViewCount.astro';
import digitalTwinImage from '../images/digital-twins-is-not-just-a-model-of-patent.png';
import educationImage from '../images/education-should-not-have-to-choose-between-east-and-west.png';
import karateImage from '../images/four-karate-styles-one-empty-hand.png';
import virtualCellImage from '../images/how-to-build-virtual-cell.png';
import precisionMedicineImage from '../images/precision-medicine.png';

const { post, large=false } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}blog/${post.id}/`.replace(/\/+/g,'/');
const cardImages: Record<string, { image: ImageMetadata; alt: string }> = {
  'digital-twins-is-not-just-a-model-of-patent': {
    image: digitalTwinImage,
    alt: 'Digital twin infographic showing patient data, a digital replica, and a clinical feedback loop.'
  },
  'how-to-build-virtual-cell': {
    image: virtualCellImage,
    alt: 'Virtual cell infographic showing experimental data, modeling approaches, and biological applications.'
  },
  'virtual-cells-predict-explain-discover': {
    image: virtualCellImage,
    alt: 'Virtual cell infographic showing experimental data, modeling approaches, and biological applications.'
  },
  'precision-medicine': {
    image: precisionMedicineImage,
    alt: 'Precision medicine infographic showing patient data, clinical decisions, and ongoing learning.'
  },
  'education-east-west': {
    image: educationImage,
    alt: 'Education illustration connecting Eastern and Western traditions through teaching, dialogue, creativity, discipline, and shared human potential.'
  },
  'four-karate-styles-one-empty-hand': {
    image: karateImage,
    alt: 'Illustrated overview of Shotokan, Goju-ryu, Shito-ryu, and Wado-ryu karate styles.'
  }
};
const cardImage = cardImages[post.id];
---
<article class:list={['post-card',{large}]} style={`--accent:${post.data.accent}`}><div class="signal" aria-hidden="true"></div><div class="meta"><span class="eyebrow">{post.data.category}</span><span class="mono">{post.data.readingTime}</span></div><h3 class="serif"><a href={href}>{post.data.title}</a></h3>{cardImage && <Image src={cardImage.image} alt={cardImage.alt} class="card-image" loading="lazy" />}<p>{post.data.description}</p><div class="bottom"><time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</time><div class="bottom-actions"><ViewCount href={href}/><a class="read-link" href={href}>Read essay →</a></div></div></article>
<style>.post-card{min-width:0;background:color-mix(in srgb,var(--paper) 88%,transparent);border:1px solid var(--ink);padding:1.2rem;display:flex;min-height:350px;flex-direction:column;position:relative;backdrop-filter:blur(8px)}.signal{height:7px;background:var(--accent);margin:-1.2rem -1.2rem 1.2rem}.meta,.bottom{display:flex;justify-content:space-between;flex-wrap:wrap;gap:.5rem 1rem;font-size:.7rem}.meta .mono{color:var(--muted)}h3{font-size:2rem;line-height:1.03;margin:2rem 0 1rem;overflow-wrap:anywhere}p{color:var(--muted);font-size:.9rem}.card-image{display:block;width:100%;height:auto;margin:0 0 1rem;border:1px solid var(--line);border-radius:.7rem}.bottom{margin-top:auto;border-top:1px solid var(--line);padding-top:1rem;text-transform:uppercase;letter-spacing:.05em;font-weight:700}.bottom-actions{display:flex;align-items:center;gap:1rem}.large{grid-column:span 2}.large h3{font-size:clamp(2rem,5vw,3.3rem);max-width:780px}@media(max-width:750px){.large{grid-column:span 1}}</style>
