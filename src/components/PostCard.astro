---
interface Props {
  title: string;
  description: string;
  date: Date;
  href: string;
  tags?: string[];
}
const { title, description, date, href, tags = [] } = Astro.props;
---
<article class="post-card">
  <div class="meta">{date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</div>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  {tags.length > 0 && <div class="tags">{tags.map((tag) => <span class="tag">{tag}</span>)}</div>}
</article>