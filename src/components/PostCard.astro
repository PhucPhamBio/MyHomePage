---
const { post, large=false } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}blog/${post.id}/`.replace(/\/+/g,'/');
---
<article class:list={['post-card',{large}]} style={`--accent:${post.data.accent}`}><div class="signal" aria-hidden="true"></div><div class="meta"><span class="eyebrow">{post.data.category}</span><span class="mono">{post.data.readingTime}</span></div><h3 class="serif"><a href={href}>{post.data.title}</a></h3><p>{post.data.description}</p><div class="bottom"><time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</time><span>Read essay →</span></div></article>
<style>.post-card{min-width:0;background:color-mix(in srgb,var(--paper) 88%,transparent);border:1px solid var(--ink);padding:1.2rem;display:flex;min-height:350px;flex-direction:column;position:relative;backdrop-filter:blur(8px)}.signal{height:7px;background:var(--accent);margin:-1.2rem -1.2rem 1.2rem}.meta,.bottom{display:flex;justify-content:space-between;flex-wrap:wrap;gap:.5rem 1rem;font-size:.7rem}.meta .mono{color:var(--muted)}h3{font-size:2rem;line-height:1.03;margin:2rem 0 1rem;overflow-wrap:anywhere}p{color:var(--muted);font-size:.9rem}.bottom{margin-top:auto;border-top:1px solid var(--line);padding-top:1rem;text-transform:uppercase;letter-spacing:.05em;font-weight:700}.large{grid-column:span 2}.large h3{font-size:clamp(2rem,5vw,3.3rem);max-width:780px}@media(max-width:750px){.large{grid-column:span 1}}</style>
