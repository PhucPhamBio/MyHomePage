---
const base = import.meta.env.BASE_URL;
---
<footer><div class="shell foot"><div><div class="eyebrow">Field notes by</div><h2 class="serif">Phuc Pham</h2><p>Computational biology, Bioinformatics, Virtual Cell Models, Digital Twins and Precision Medicine.</p></div><nav class="links" aria-label="Footer"><a href={`${base}blog/`}>Explore essays ↗</a><a href={`${base}topics/computational-biology/`}>Computational biology ↗</a><a href={`${base}about/`}>About me ↗</a></nav></div><div class="shell end mono">© {new Date().getFullYear()} · BIOLOGY INTELLIGENCE · PUBLISHED FROM BIRMINGHAM, AL · phpham@uab.edu<br/><a class="backdrop-credit" href="https://giphy.com/gifs/wallpaper-OK5LK5zLFfdm"></a></div></footer>
<style>footer{margin-top:8rem;background:var(--ink);color:var(--paper);padding:4rem 0 1.5rem}.foot{display:grid;grid-template-columns:2fr 1fr;gap:3rem}.foot h2{font-size:3rem;margin:.4rem 0}.foot p{color:#b8b8ae}.links{display:flex;flex-direction:column;gap:.75rem;align-items:flex-start}.links a{border-bottom:1px solid}.end{font-size:.68rem;border-top:1px solid #555;margin-top:4rem;padding-top:1rem}.backdrop-credit{display:inline-block;margin-top:.35rem;text-decoration:underline;text-underline-offset:2px}@media(max-width:650px){.foot{grid-template-columns:1fr}.foot h2{font-size:2.2rem}}</style>
